# Scripts and config run on Linux: always LF, whatever the checkout platform.
*.sh    text eol=lf
*.sql   text eol=lf
*.conf  text eol=lf
*.cnf   text eol=lf
*.ini   text eol=lf
*.in    text eol=lf
*.php   text eol=lf
*.json  text eol=lf
*.lock  text eol=lf
*.xml   text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.service text eol=lf
*.timer   text eol=lf
# Vendored files stay byte for byte as published, so their SHA-256 in
# decisions.md (M-054) matches on every checkout.
public/dashboard/assets/vendor/** -text
