{
    "name": "aio/mothership",
    "description": "All In 1 Monitor mothership: ingest API, storage, dashboard",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Aio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aio\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration"
    }
}
