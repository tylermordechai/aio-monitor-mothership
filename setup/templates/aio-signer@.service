# Managed by aio-mothership setup/11-enrolment.sh. Do not edit here.
# One copy per connection on /run/aio-signer.sock (aio-signer.socket).
# Runs as aio-signer, the only non-root reader of the agent CA key (M-037,
# MS-SEC-02). No network, no database, nothing writable but its private /tmp.
[Unit]
Description=AIO Mothership agent CA signing service (one request)

[Service]
Type=oneshot
User=aio-signer
Group=aio-signer
ExecStart=/usr/bin/php @AIO_REPO@/bin/signer.php
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=20

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
